// Prisma Schema for Hopenix LMS (Dev: SQLite, Prod: Neon PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  String                 @default("EDITOR") // ADMIN, EDITOR
  avatar                String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  permissions           LessonEditorPermission[]
  bookEditorPermissions BookEditorPermission[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([role])
}

model ClassGrade {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Course[]

  @@index([name])
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Course[]

  @@index([name])
}

model Course {
  id                    String                 @id @default(uuid())
  title                 String
  slug                  String                 @unique
  description           String
  shortDescription      String?
  author                String?
  coverImage            String?
  thumbnail             String?
  category              String?
  publicationYear       Int?
  isbn                  String?
  language              String?                @default("English")
  readingLevel          String?
  classGradeId          String?
  classGrade            ClassGrade?            @relation(fields: [classGradeId], references: [id], onDelete: SetNull)
  subjectId             String?
  subject               Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  featured              Boolean                @default(false)
  published             Boolean                @default(false)
  qrLogo                String?
  qrCodeData            String?
  qrCodeUrl             String?
  qrGeneratedAt         DateTime?
  readingTime           String?
  companyName           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lessons               Lesson[]
  editorPermissions     BookEditorPermission[]
  qrCode                QRCode?

  @@index([slug])
  @@index([published])
  @@index([category])
  @@index([classGradeId])
  @@index([subjectId])
}

model Lesson {
  id             String                   @id @default(uuid())
  courseId       String
  course         Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String?
  content        String?
  youtubeUrl     String?
  youtubeVideoId String?
  lessonNumber   Int                      @default(1)
  readingTime    String?
  order          Int                      @default(0)
  published      Boolean                  @default(false)
  qrLogo         String?
  qrCodeData     String?
  qrCodeUrl      String?
  qrGeneratedAt  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  media          Media[]
  permissions    LessonEditorPermission[]
  qrCode         QRCode?

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([published])
}

model Media {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type      String   // IMAGE, VIDEO, PDF
  url       String
  name      String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model QRCode {
  id             String   @id @default(uuid())
  bookId         String?  @unique
  book           Course?  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lessonId       String?  @unique
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  destinationUrl String
  imageUrl       String
  logoUrl        String?
  logoConfig     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookId])
  @@index([lessonId])
}

model BookEditorPermission {
  id        String   @id @default(uuid())
  bookId    String
  book      Course   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([userId])
  @@index([bookId])
}

model LessonEditorPermission {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lessonId, userId])
  @@index([userId])
  @@index([lessonId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

